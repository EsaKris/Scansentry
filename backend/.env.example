# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=http://localhost:5173

# --- Database (leave empty for local SQLite) ---
# Supabase: Project Settings > Database > Connection string.
# Direct / session pooler (port 5432) for migrations:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Transaction pooler (port 6543) also needs DB_DISABLE_SERVER_SIDE_CURSORS=true
DATABASE_URL=
DB_SSL_REQUIRE=false
DB_DISABLE_SERVER_SIDE_CURSORS=false
DB_CONN_MAX_AGE=60

# --- JWT ---
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# --- Email (console backend prints emails to the terminal) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ScanSentry <no-reply@scansentry.local>

# --- Public URL of the redirect/verification domain used inside dynamic QR codes ---
REDIRECT_BASE_URL=http://localhost:8000
# Number of trusted reverse proxies in front of the API (0 = ignore X-Forwarded-For)
NUM_PROXIES=0

# --- Domain intelligence / outbound network safety ---
DOMAIN_CHECK_TIMEOUT=20
NETGUARD_CONNECT_TIMEOUT=5
NETGUARD_TOTAL_TIMEOUT=10
NETGUARD_MAX_REDIRECTS=5
NETGUARD_MAX_BODY_BYTES=65536
# Comma-separated resolver IPs; empty = system resolver. Use a trusted resolver in production.
DNS_NAMESERVERS=
DNS_TIMEOUT=4
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
RDAP_TIMEOUT=8
# Optional JSON, e.g. {"fallback_base": "https://rdap.example.net"} - check the provider's terms first
RDAP_PROVIDER_CONFIG=

# --- Analytics ---
# Country/region come ONLY from headers your CDN/proxy sets (strip them from client requests). Empty = off.
GEO_COUNTRY_HEADER=
GEO_REGION_HEADER=
ANALYTICS_DEDUPE_SECONDS=30

# --- Cache / rate limits ---
# REQUIRED in production (config.settings.production refuses to start without it): rate limits must be shared by every worker.
# Example: redis://default:password@host:6379/0  (use rediss:// for TLS). Leave blank only for local development.
REDIS_URL=
# Threat intelligence: the key for Google Web Risk (commercial). Enable the provider in the admin.
THREAT_INTEL_API_KEY=
# AI explanations (optional). AI_PROVIDER = anthropic or empty. Verify AI_MODEL in Anthropic's docs.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT=10
# Payments. Secrets only here, never in the database or the frontend. Also set billing.enabled_providers in the admin.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Where providers send the user after paying (default: FRONTEND_URL + /billing/complete)
BILLING_RETURN_URL=
STRIPE_SECRET_KEY=

# =====================================================================================
# Production (config.settings.production). See docs/DEPLOYMENT.md
# =====================================================================================
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_SECRET_KEY must be 32+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# DJANGO_ALLOWED_HOSTS must be your real API host, CORS_ALLOWED_ORIGINS must be https:// origins.
# SECURE_SSL_REDIRECT=true            # set false only if your platform terminates TLS and cannot send X-Forwarded-Proto
# Move the admin sign-in away from /admin/ (obscurity only; also restrict it by IP/VPN if you can), and limit sign-in attempts:
# DJANGO_ADMIN_URL=ops-change-me/
# ADMIN_LOGIN_ATTEMPTS=10
# ADMIN_LOGIN_WINDOW_SECONDS=900

# Web server (gunicorn.conf.py)
# PORT=8000
# WEB_CONCURRENCY=3                    # use 1 with ALLOW_LOCAL_CACHE_SINGLE_WORKER=true if you have no Redis (not recommended)
# ALLOW_LOCAL_CACHE_SINGLE_WORKER=false
# GUNICORN_ACCESS_LOG=false            # when true it logs the request PATH only (never the query string or client address)
# GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1

# Logging: JSON in production. LOG_REQUESTS=true also logs 2xx/3xx/4xx lines (path only); 5xx are always logged.
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# LOG_REQUESTS=false

# Error monitoring (optional). Events are scrubbed of query strings, cookies, bodies, headers and user identity.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
# APP_RELEASE=                         # e.g. the git commit hash

# Private file storage (QR logos, abuse evidence). A PaaS disk is wiped on every deploy: use object storage.
# FILE_STORAGE_PROVIDER=s3             # "filesystem" (default) is only safe with a persistent volume at MEDIA_ROOT
# S3_BUCKET_NAME=
# S3_ENDPOINT_URL=                     # blank for AWS; Supabase Storage: https://<project>.supabase.co/storage/v1/s3
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Run the test suite against PostgreSQL (production's database) instead of SQLite:
# TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/scansentry
