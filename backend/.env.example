# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=http://localhost:5173

# --- Database (leave empty for local SQLite) ---
# Supabase: Project Settings > Database > Connection string.
# Direct / session pooler (port 5432) for migrations:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Transaction pooler (port 6543) also needs DB_DISABLE_SERVER_SIDE_CURSORS=true
DATABASE_URL=
DB_SSL_REQUIRE=false
DB_DISABLE_SERVER_SIDE_CURSORS=false
DB_CONN_MAX_AGE=60

# --- JWT ---
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# --- Email (console backend prints emails to the terminal) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ScanSentry <no-reply@scansentry.local>

# --- Public URL of the redirect/verification domain used inside dynamic QR codes ---
REDIRECT_BASE_URL=http://localhost:8000
# Number of trusted reverse proxies in front of the API (0 = ignore X-Forwarded-For)
NUM_PROXIES=0

# --- Domain intelligence / outbound network safety ---
DOMAIN_CHECK_TIMEOUT=20
NETGUARD_CONNECT_TIMEOUT=5
NETGUARD_TOTAL_TIMEOUT=10
NETGUARD_MAX_REDIRECTS=5
NETGUARD_MAX_BODY_BYTES=65536
# Comma-separated resolver IPs; empty = system resolver. Use a trusted resolver in production.
DNS_NAMESERVERS=
DNS_TIMEOUT=4
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
RDAP_TIMEOUT=8
# Optional JSON, e.g. {"fallback_base": "https://rdap.example.net"} - check the provider's terms first
RDAP_PROVIDER_CONFIG=

# --- Later milestones (leave blank until needed) ---
REDIS_URL=
THREAT_INTEL_PROVIDER=
THREAT_INTEL_API_KEY=
AI_PROVIDER=
AI_API_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
STRIPE_SECRET_KEY=
